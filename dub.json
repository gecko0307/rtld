{
    "name": "rtld",
    "description": "Real-Time Library for D",
    "homepage": "",
    "license": "BSL-1.0",
    "authors": [
        "Timur Gafarov"
    ],
    "copyright": "Copyright © 2026, Timur Gafarov",
    
    "importPaths": [
        "src"
    ],
    
    "sourcePaths": [
        "src"
    ],
    
    "buildRequirements":[
        "allowWarnings"
    ],
    
    "configurations": [
        {
            "name": "default",
            "targetType": "library",
            "versions": ["Phobos"]
        },
        {
            "name": "replace-druntime",
            "targetType": "staticLibrary",
            "importPaths": [
                "src",
                "runtime/src"
            ],
            "sourcePaths": [
                "src",
                "runtime/src"
            ],
            "dflags": [
                "-defaultlib=",
                "-debuglib="
            ],
            "lflags-windows": [
                "/INCLUDE:main"
            ],
            "lflags-linux": [
                "--undefined=main"
            ]
        }
    ],
    
    "-ddoxTool": "scod"
}
