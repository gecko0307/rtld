    assert(approx(powFallback(9.0, 0.5), 3.0, 1e-12));
    assert(approx(powFallback(10.0, 2.0), 100.0, 1e-12));
    assert(approx(powFallback(10.0, -3.0), 1e-3, 1e-12));
