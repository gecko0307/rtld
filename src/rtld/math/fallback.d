T atan2Fallback(T)(T y, T x) pure nothrow @nogc
    if (isFloatingPoint!T)
{
    if (x > 0)
        return atanFallback(y / x);
    else if (x < 0 && y >= 0)
        return atanFallback(y / x) + PI;
    else if (x < 0 && y < 0)
        return atanFallback(y / x) - PI;
    else if (x == 0 && y > 0)
        return HALFPI;
    else if (x == 0 && y < 0)
        return -HALFPI;
    else
        return 0; // Undefined
}

