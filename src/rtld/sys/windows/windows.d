enum WM_NCCREATE = 0x0081;
enum WM_DESTROY  = 0x0002;
enum WM_SIZE     = 0x0005;

enum GWLP_USERDATA      = -21;

enum IDC_ARROW = cast(LPCWSTR)32512;
enum COLOR_WINDOW       = 5;

enum WS_OVERLAPPEDWINDOW = 0x00CF0000;
