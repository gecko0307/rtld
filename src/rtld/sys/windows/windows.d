module rtld.sys.windows.windows;

version(Windows):

pragma(lib, "kernel32");
pragma(lib, "user32");
pragma(lib, "gdi32");

alias VOID = void;
alias HANDLE = void*;
alias HMODULE = void*;
alias BYTE = ubyte;
alias WORD = ushort;
alias BOOL = int;
alias DWORD = uint;
alias UINT = uint;
alias LONG = int;
alias ULONG = uint;
alias LONGLONG = long;
alias LPVOID = void*;
alias FLOAT = float;

alias LONG_PTR = ptrdiff_t;
